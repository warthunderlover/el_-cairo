<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRuta"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FBFF"
    tools:context=".ruta">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1C2A3A"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Rutas"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:gravity="center_vertical" />

        <ImageView
            android:id="@+id/homeIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_home"
            android:contentDescription="Inicio"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:orientation="horizontal"
        android:padding="10dp">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="357dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="#E6EFFF"
            android:hint="Buscar Rutas"
            android:paddingHorizontal="10dp" />

        <ImageButton
            android:id="@+id/searchButton"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:contentDescription="Buscar"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <TextView
        android:id="@+id/textInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/searchBar"
        android:layout_margin="16dp"
        android:text="Agregue Seleccione una Ruta:"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/addRouteBox"
        android:layout_width="234dp"
        android:layout_height="151dp"
        android:layout_below="@id/textInstruction"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:background="#D9D9D9"
        android:gravity="center">

        <ImageView
            android:id="@+id/plusIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="Agregar Ruta"
            android:src="@drawable/ic_add_blue" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/routeSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_below="@id/addRouteBox"
        android:layout_marginTop="20dp"
        android:padding="16dp" />

    <LinearLayout
        android:id="@+id/navigationButtons"
        android:layout_width="265dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/routeSlider"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:backgroundTint="#FF0000"
            android:text="Volver"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnSiguiente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#009929"
            android:text="Siguiente"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#1C2A3A">

        <View
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="-20dp"
            android:background="@drawable/curve_top" />

        <ImageView
            android:id="@+id/notificationIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_bell"
            android:contentDescription="Notificación" />
    </RelativeLayout>

</RelativeLayout>