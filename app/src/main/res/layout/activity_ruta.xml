<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF1F6"
    tools:context=".ruta">

    <!-- Barra superior -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#5564AD"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Rutas"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"
            android:gravity="center_vertical" />

        <ImageView
            android:id="@+id/homeIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_home"
            android:contentDescription="Inicio" />
    </LinearLayout>

    <!-- Buscador -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:hint="Buscar Rutas"
            android:paddingHorizontal="10dp" />

        <ImageButton
            android:id="@+id/searchButton"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:contentDescription="Buscar"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <!-- Texto -->
    <TextView
        android:id="@+id/textInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/searchBar"
        android:layout_margin="16dp"
        android:text="Agregue o seleccionese una ruta:"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Cuadro para agregar ruta -->
    <LinearLayout
        android:id="@+id/addRouteBox"
        android:layout_width="234dp"
        android:layout_height="151dp"
        android:layout_below="@id/textInstruction"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:background="#D9D9D9"
        android:gravity="center">

        <ImageView
            android:id="@+id/plusIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:contentDescription="Agregar Ruta"
            android:src="@drawable/ic_add_blue" />
    </LinearLayout>

    <!-- Slider horizontal con rutas -->
    <HorizontalScrollView
        android:id="@+id/routeScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/addRouteBox"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/sliderLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp" />
    </HorizontalScrollView>

    <!-- Barra inferior con campana -->
    <RelativeLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#5564AD">

        <ImageView
            android:id="@+id/notificationIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_bell"
            android:contentDescription="Notificación" />
    </RelativeLayout>
</RelativeLayout>
